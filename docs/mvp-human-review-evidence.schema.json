{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridoc.local/schemas/mvp-human-review-evidence-v1.schema.json",
  "title": "VeriDoc MVP human-review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "decision_revision",
    "manifest_revision",
    "study_id",
    "study_status",
    "practice_revision",
    "case_ids",
    "consent_approval",
    "quality_approval",
    "participants",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "veridoc-mvp-human-review-evidence/v1"
    },
    "protocol_version": {
      "const": "p12g-13-human-review-v1"
    },
    "decision_revision": {
      "const": "p12g-02-v1"
    },
    "manifest_revision": {
      "const": "phase12-mvp-v1"
    },
    "study_id": {
      "type": "string",
      "pattern": "^HR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "study_status": {
      "enum": [
        "validation_example",
        "completed"
      ]
    },
    "practice_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mvp-word-001",
          "mvp-excel-001",
          "mvp-text-pdf-001",
          "mvp-scanned-pdf-001",
          "mvp-record-pdf-001"
        ]
      }
    },
    "consent_approval": {
      "$ref": "#/$defs/consentApproval"
    },
    "quality_approval": {
      "$ref": "#/$defs/qualityApproval"
    },
    "participants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "runs": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "consentApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "approved_at",
        "approved_by_role",
        "consent_form_version",
        "direct_identifiers_stored"
      ],
      "properties": {
        "approval_status": {
          "const": "approved"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by_role": {
          "const": "study_owner"
        },
        "consent_form_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "direct_identifiers_stored": {
          "const": false
        }
      }
    },
    "qualityApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_status",
        "approved_at",
        "approved_by_role",
        "external_record_version"
      ],
      "properties": {
        "approval_status": {
          "const": "approved"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by_role": {
          "const": "quality_approver"
        },
        "external_record_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "participation_status",
        "relevant_experience_attested",
        "manual_practice_completed",
        "manual_practice_completed_at",
        "veridoc_practice_completed",
        "veridoc_practice_completed_at",
        "arm_order"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "pattern": "^P[0-9]{3,}$"
        },
        "participation_status": {
          "enum": [
            "completed",
            "withdrawn"
          ]
        },
        "relevant_experience_attested": {
          "const": true
        },
        "manual_practice_completed": {
          "const": true
        },
        "manual_practice_completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "veridoc_practice_completed": {
          "const": true
        },
        "veridoc_practice_completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "arm_order": {
          "oneOf": [
            {
              "const": [
                "manual",
                "veridoc"
              ]
            },
            {
              "const": [
                "veridoc",
                "manual"
              ]
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "participant_id",
        "case_id",
        "arm",
        "attempt_number",
        "task_revision",
        "gold_answer_revision",
        "gold_answer_hidden_until_ended_at",
        "gold_answer_compared_by_role",
        "gold_answer_comparison_withheld_from_participant",
        "started_at",
        "ended_at",
        "excluded_pause_seconds",
        "outcome",
        "checklist_complete",
        "blocker_code",
        "high_risk_expected_count",
        "high_risk_miss_count",
        "over_detection_count",
        "excluded",
        "exclusion_reason_code"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^RUN-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "participant_id": {
          "type": "string",
          "pattern": "^P[0-9]{3,}$"
        },
        "case_id": {
          "type": "string"
        },
        "arm": {
          "enum": [
            "manual",
            "veridoc"
          ]
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "task_revision": {
          "const": "task-phase12-v1"
        },
        "gold_answer_revision": {
          "const": "gold-phase12-v1"
        },
        "gold_answer_hidden_until_ended_at": {
          "const": true
        },
        "gold_answer_compared_by_role": {
          "const": "independent_assessor"
        },
        "gold_answer_comparison_withheld_from_participant": {
          "const": true
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "excluded_pause_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "approved",
            "blocked"
          ]
        },
        "checklist_complete": {
          "type": "boolean"
        },
        "blocker_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "source_unreadable",
            "tool_unavailable",
            "required_information_missing",
            "approval_unavailable",
            "other_controlled"
          ]
        },
        "high_risk_expected_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_risk_miss_count": {
          "type": "integer",
          "minimum": 0
        },
        "over_detection_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "boolean"
        },
        "exclusion_reason_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "technical_failure",
            "protocol_deviation",
            "participant_withdrew",
            "invalid_timing"
          ]
        }
      }
    }
  }
}
